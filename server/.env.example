# Copy this file to ".env" and fill in real values.
# Get DATABASE_URL from your Neon project (personal Google account):
#   neon.tech -> create project -> copy the connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Any random long string; signs login tokens.
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
